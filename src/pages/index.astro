---
import Layout from "../layouts/Layout.astro";
import RegistroAlumno from "../components/RegistroAlumno.vue";
import ListaAlumnos from "../components/ListaAlumnos.vue";
import ReporteGrados from "../components/ReporteGrados.vue";
import GestionNotas from "../components/GestionNotas.vue";
import BoletaNotas from "../components/BoletaNotas.vue";
import AulaVirtual from "../components/AulaVirtual.vue"; // <--- NUEVO
---

<Layout title="Dashboard | Plataforma Eva">
  <div class="max-w-7xl mx-auto px-4 mb-8">
    <div class="bg-white p-6 rounded-3xl shadow-xl border border-slate-100 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 bg-[#002855] rounded-2xl flex items-center justify-center shadow-lg border-b-4 border-yellow-500">
          <span class="text-white text-2xl font-black italic">E</span>
        </div>
        <div>
          <h2 class="text-2xl font-black text-slate-800 tracking-tighter" id="welcome-msg">Cargando...</h2>
          <p class="text-slate-400 text-[10px] font-bold uppercase tracking-widest" id="role-badge">Verificando...</p>
        </div>
      </div>
      <button onclick="localStorage.clear(); window.location.href='/login';" class="bg-red-50 text-red-600 px-6 py-3 rounded-2xl font-black text-xs hover:bg-red-600 hover:text-white transition-all shadow-sm flex items-center gap-2">
        CERRAR SESIÓN 🚪
      </button>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 mb-10 flex gap-4 overflow-x-auto pb-2">
    <button onclick="cambiarTab('registros')" id="btn-registros" class="bg-[#002855] text-white px-8 py-4 rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-xl transition-all whitespace-nowrap">
      📊 Registros y Notas
    </button>
    <button onclick="cambiarTab('aula')" id="btn-aula" class="bg-white text-slate-400 px-8 py-4 rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-sm hover:shadow-lg transition-all border border-slate-100 whitespace-nowrap">
      🎥 Aula Virtual
    </button>
  </div>

  <div id="tab-registros" class="animate-fade-in">
    <div id="panel-docente" class="hidden">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start px-4 mb-12">
        <RegistroAlumno client:load />
        <ReporteGrados client:load />
      </div>
      <div class="px-4 mb-12">
        <GestionNotas client:load />
      </div>
    </div>
    <div id="panel-estudiante" class="hidden px-4 mb-12">
      <BoletaNotas client:load />
    </div>
    <div class="px-4 mb-20">
      <ListaAlumnos client:load />
    </div>
  </div>

  <div id="tab-aula" class="hidden animate-fade-in px-4">
     <AulaVirtual client:load />
  </div>

</Layout>

<script is:inline>
  function cambiarTab(tab) {
    const tabRegistros = document.getElementById('tab-registros');
    const tabAula = document.getElementById('tab-aula');
    const btnRegistros = document.getElementById('btn-registros');
    const btnAula = document.getElementById('btn-aula');

    if (tab === 'registros') {
      tabRegistros.classList.remove('hidden');
      tabAula.classList.add('hidden');
      btnRegistros.className = "bg-[#002855] text-white px-8 py-4 rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-xl";
      btnAula.className = "bg-white text-slate-400 px-8 py-4 rounded-2xl font-black text-[10px] uppercase tracking-widest border border-slate-100";
    } else {
      tabRegistros.classList.add('hidden');
      tabAula.classList.remove('hidden');
      btnAula.className = "bg-[#002855] text-white px-8 py-4 rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-xl";
      btnRegistros.className = "bg-white text-slate-400 px-8 py-4 rounded-2xl font-black text-[10px] uppercase tracking-widest border border-slate-100";
    }
  }

  function verificarAcceso() {
    const rol = localStorage.getItem("user_rol");
    const nombre = localStorage.getItem("user_name");
    if (!rol) { window.location.href = "/login"; return; }

    document.getElementById("welcome-msg").innerText = `¡Hola, ${nombre}!`;
    document.getElementById("role-badge").innerText = `Nivel: ${rol}`;

    const panelDocente = document.getElementById("panel-docente");
    const panelEstudiante = document.getElementById("panel-estudiante");

    if (rol === "DOCENTE") { panelDocente.classList.remove("hidden"); }
    else { panelEstudiante.classList.remove("hidden"); }
  }

  verificarAcceso();
</script>