---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Cambiar contraseña | EVA">
  <main class="min-h-screen bg-[#f8fafc] flex items-center justify-center px-4">
    <div class="w-full max-w-md">
      <div class="bg-white rounded-[2rem] shadow-2xl border border-slate-200 p-8">
        <div class="mb-6 text-center">
          <h1 class="text-2xl font-black text-[#002855] uppercase tracking-tight">
            Cambiar contraseña
          </h1>
          <p class="text-slate-500 text-sm mt-2">
            Por seguridad, debes actualizar tu contraseña temporal.
          </p>
        </div>

        <form id="password-form" class="space-y-5">
          <div>
            <label class="block text-[11px] font-black uppercase tracking-[0.2em] text-slate-500 mb-2">
              Contraseña actual
            </label>
            <input
              id="current-password"
              type="password"
              class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-4 text-slate-800 font-bold outline-none focus:border-[#002855] focus:ring-2 focus:ring-blue-100 transition-all"
            />
          </div>

          <div>
            <label class="block text-[11px] font-black uppercase tracking-[0.2em] text-slate-500 mb-2">
              Nueva contraseña
            </label>
            <input
              id="new-password"
              type="password"
              class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-4 text-slate-800 font-bold outline-none focus:border-[#002855] focus:ring-2 focus:ring-blue-100 transition-all"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-[#002855] hover:bg-[#001d3d] text-white rounded-2xl py-4 font-black uppercase tracking-[0.2em] shadow-xl transition-all"
          >
            Guardar contraseña
          </button>
        </form>

        <div id="message" class="hidden mt-5 rounded-2xl px-4 py-3 text-sm font-semibold"></div>
      </div>
    </div>
  </main>

  <script is:inline>
    const form = document.getElementById("password-form");
    const message = document.getElementById("message");

    function showMessage(text, ok = false) {
      message.classList.remove("hidden");
      message.textContent = text;
      message.className = ok
        ? "mt-5 rounded-2xl px-4 py-3 text-sm font-semibold bg-green-50 border border-green-200 text-green-700"
        : "mt-5 rounded-2xl px-4 py-3 text-sm font-semibold bg-red-50 border border-red-200 text-red-700";
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const PK = localStorage.getItem("user_pk");
      const currentPassword = document.getElementById("current-password").value;
      const newPassword = document.getElementById("new-password").value;

      try {
        const res = await fetch("/api/cambiar-password", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            PK,
            currentPassword,
            newPassword,
          }),
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data?.error || "No se pudo actualizar la contraseña");
        }

        localStorage.setItem("must_change_password", "false");
        showMessage("Contraseña actualizada correctamente. Redirigiendo...", true);

        setTimeout(() => {
          window.location.href = "/";
        }, 900);
      } catch (err) {
        showMessage(err.message || "Ocurrió un error inesperado");
      }
    });
  </script>
</Layout>